diff --git a/RhythmBackend/Services/MentraCoachRequest.cs b/RhythmBackend/Services/MentraCoachRequest.cs
new file mode 100644
index 0000000..a7b58b3
--- /dev/null
+++ b/RhythmBackend/Services/MentraCoachRequest.cs
@@ -0,0 +1,102 @@
+using System.Text.Json;
+using System.Text.Json.Serialization;
+
+namespace RhythmBackend.Services;
+
+public sealed record MentraOverall(
+    [property: JsonPropertyName("accuracy_pct")] double? AccuracyPct,
+    [property: JsonPropertyName("offset_mean_ms")] double? OffsetMeanMs,
+    [property: JsonPropertyName("offset_spread_ms")] double? OffsetSpreadMs,
+    [property: JsonPropertyName("notes")] int? Notes);
+
+public sealed record MentraSection
+{
+    [JsonPropertyName("start_s")] public int StartS { get; init; }
+    [JsonPropertyName("end_s")] public int EndS { get; init; }
+    [JsonPropertyName("accuracy_pct")] public double? AccuracyPct { get; init; }
+    [JsonPropertyName("offset_mean_ms")] public double? OffsetMeanMs { get; init; }
+    [JsonPropertyName("offset_spread_ms")] public double? OffsetSpreadMs { get; init; }
+}
+
+public sealed record MentraFacts
+{
+    [JsonPropertyName("overall")] public required MentraOverall Overall { get; init; }
+    [JsonPropertyName("sections")] public List<MentraSection> Sections { get; init; } = [];
+    [JsonPropertyName("weakest_section")] public MentraSection? WeakestSection { get; init; }
+    [JsonPropertyName("usable_for_coaching")] public bool UsableForCoaching { get; init; } = true;
+    [JsonPropertyName("data_notes")] public string[] DataNotes { get; init; } = [];
+}
+
+public sealed record MentraRun
+{
+    [JsonPropertyName("source")] public required string Source { get; init; }
+    [JsonPropertyName("tier")] public required string Tier { get; init; }
+    [JsonPropertyName("song")] public JsonElement Song { get; init; }
+    [JsonPropertyName("facts")] public required MentraFacts Facts { get; init; }
+}
+
+public sealed record MentraTurn(
+    [property: JsonPropertyName("role")] string Role,
+    [property: JsonPropertyName("text")] string Text);
+
+public sealed record MentraCoachRequest
+{
+    [JsonPropertyName("mode")] public required string Mode { get; init; }
+    [JsonPropertyName("tier")] public string? Tier { get; init; }
+    [JsonPropertyName("question")] public string? Question { get; init; }
+    [JsonPropertyName("runs")] public List<MentraRun> Runs { get; init; } = [];
+    [JsonPropertyName("session")] public JsonElement? Session { get; init; }
+    [JsonPropertyName("history")] public List<MentraTurn> History { get; init; } = [];
+
+    public void Validate()
+    {
+        if (Mode is not ("song_debrief" or "session_debrief" or "chat"))
+            throw new ArgumentException("Unknown coaching mode.");
+        if (Runs is null || Runs.Count > 20 || History is null || History.Count > 20)
+            throw new ArgumentException("At most 20 recent runs and chat turns are accepted.");
+        if (Mode == "song_debrief" && Runs.Count != 1)
+            throw new ArgumentException("Song coaching requires exactly one run.");
+        if (Mode == "session_debrief" && (Runs.Count == 0 || Session is null))
+            throw new ArgumentException("Session coaching requires computed session facts.");
+        if (Mode == "chat" && (string.IsNullOrWhiteSpace(Question) || Question.Length > 2000))
+            throw new ArgumentException("Chat requires a message of at most 2000 characters.");
+        if (History.Any(t => t is null || t.Role is not ("user" or "assistant") || string.IsNullOrWhiteSpace(t.Text) || t.Text.Length > 2000))
+            throw new ArgumentException("Invalid chat history.");
+        foreach (var run in Runs)
+        {
+            if (run is null || run.Source is not ("custom_game_csv" or "custom_game_summary" or "screen_ocr")
+                || run.Tier is not ("A" or "B") || run.Facts is null || run.Facts.Overall is null
+                || run.Facts.Sections is null || run.Facts.Sections.Count > 1000
+                || run.Facts.DataNotes is null || run.Facts.DataNotes.Any(s => s is null || s.Length > 2000))
+                throw new ArgumentException("Invalid run evidence.");
+            if (run.Song.ValueKind != JsonValueKind.Object || run.Song.GetRawText().Length > 5000)
+                throw new ArgumentException("Run song metadata must be an object.");
+            var overall = run.Facts.Overall;
+            Percent(overall.AccuracyPct); Finite(overall.OffsetMeanMs); Spread(overall.OffsetSpreadMs);
+            if (overall.Notes < 0) throw new ArgumentException("Note count cannot be negative.");
+            if (run.Tier == "B" && run.Facts.Sections.Count != 0)
+                throw new ArgumentException("Summary-only runs cannot provide a per-second section series.");
+            if (run.Tier == "A" && (run.Source != "custom_game_csv" || run.Facts.Sections.Count == 0))
+                throw new ArgumentException("Tier A requires custom-game CSV sections.");
+            int end = 0;
+            foreach (var section in run.Facts.Sections)
+            {
+                if (section is null || section.StartS < end || section.EndS <= section.StartS)
+                    throw new ArgumentException("Sections must have ordered, non-overlapping time windows.");
+                Percent(section.AccuracyPct); Finite(section.OffsetMeanMs); Spread(section.OffsetSpreadMs);
+                end = section.EndS;
+            }
+            if (run.Facts.WeakestSection is { } weak)
+            {
+                if (weak.StartS < 0 || weak.EndS <= weak.StartS) throw new ArgumentException("Invalid weakest section.");
+                Percent(weak.AccuracyPct);
+            }
+        }
+        string? expected = Runs.Count == 0 ? null : Runs.Select(r => r.Tier).Distinct().Count() == 1 ? Runs[0].Tier : "mixed";
+        if (Tier != expected) throw new ArgumentException("Root tier does not match the supplied runs.");
+    }
+
+    private static void Finite(double? v) { if (v.HasValue && !double.IsFinite(v.Value)) throw new ArgumentException("Measurements must be finite or null."); }
+    private static void Percent(double? v) { Finite(v); if (v is < 0 or > 100) throw new ArgumentException("Accuracy must use 0 to 100 percent."); }
+    private static void Spread(double? v) { Finite(v); if (v < 0) throw new ArgumentException("Spread cannot be negative."); }
+}
