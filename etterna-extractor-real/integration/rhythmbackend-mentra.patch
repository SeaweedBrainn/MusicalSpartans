+namespace RhythmBackend.Services;
+
+public static class MentraEndpoints
+{
+    public static void MapMentraIntegration(this WebApplication app)
+    {
+        app.MapGet("/api/mentra/health", (IConfiguration config) => Results.Ok(new {
+            service = "RhythmBackend", mentra_contract = 1, speech_format_retries = 1,
+            gemini_configured = !string.IsNullOrWhiteSpace(config["GEMINI_API_KEY"])
+        }));
+        app.MapPost("/api/mentra/coach", async (MentraCoachRequest request, IServiceProvider services,
+            IConfiguration config, CancellationToken token) => {
+            try { request.Validate(); }
+            catch (ArgumentException error) { return Results.BadRequest(new { error = error.Message }); }
+            if (string.IsNullOrWhiteSpace(config["GEMINI_API_KEY"]))
+                return Results.Problem("Configure GEMINI_API_KEY on RhythmBackend to enable AI coaching.", statusCode: 503);
+            try {
+                var gemini = services.GetRequiredService<GeminiService>();
+                var coach = await gemini.CoachFactsAsync(request, token);
+                return Results.Ok(new { provider = "rhythm_backend", coach });
+            }
+            catch (OperationCanceledException) { return Results.Problem("Coaching request timed out or was cancelled.", statusCode: 504); }
+            catch (CoachResponseException error) { app.Logger.LogWarning("Mentra coach reply rejected: {Code}; {Diagnostic}", error.Code, error.Code == "coach_speech_rejected" ? error.Message : "Response validation failed"); return Results.Problem(error.Message, statusCode: 502,
+                extensions: new Dictionary<string, object?> { ["errorCode"] = error.Code }); }
+            catch (Exception error) { app.Logger.LogWarning("Mentra coaching failed ({Type}); inspect model configuration and provider availability.", error.GetType().Name); return Results.Problem("Unable to generate AI coaching.", statusCode: 502); }
+        });
+    }
+}
