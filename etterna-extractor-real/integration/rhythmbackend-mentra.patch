@@ -0,0 +1,40 @@
+namespace RhythmBackend.Services;
+
+/// <summary>One format-repair attempt, inside the caller's shared time budget.</summary>
+public static class CoachGenerationRetry
+{
+    public static async Task<CoachResponse> GenerateAsync(
+        Func<string?, CancellationToken, Task<CoachResponse>> generate,
+        string mode, string? tier, MentraCoachRequest? grounding, CancellationToken token)
+    {
+        string? correction = null;
+        for (int attempt = 0; attempt < 2; attempt++)
+        {
+            token.ThrowIfCancellationRequested();
+            var output = await generate(correction, token);
+            token.ThrowIfCancellationRequested();
+            try
+            {
+                CoachResponseValidator.Validate(output, mode, tier, grounding);
+                return output;
+            }
+            catch (CoachResponseException error) when (error.Code == "coach_speech_rejected" && attempt == 0)
+            {
+                string target = mode switch
+                {
+                    "song_debrief" => "70 to 80 whitespace-separated words",
+                    "session_debrief" => "100 to 120 whitespace-separated words in exactly two paragraphs: session observations, then practice actions",
+                    "chat" => "25 to 60 whitespace-separated words",
+                    _ => throw new InvalidOperationException("Unknown mode")
+                };
+                correction = "Formatting repair: the previous reply failed speech-format validation. " + error.Message + " " +
+                    $"Regenerate the complete response JSON with speech containing {target}. " +
+                    "Use plain prose without URLs, links or square-bracket references. " +
+                    "Preserve the original mode, tier, available measurements and evidence limits. " +
+                    "Do not invent facts or add unsupported claims to meet the length. " +
+                    "Return all required JSON fields and check speech length before responding.";
+            }
+        }
+        throw new InvalidOperationException("Unreachable generation state");
+    }
+}
