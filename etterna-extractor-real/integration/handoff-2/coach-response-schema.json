{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["song_debrief", "session_debrief", "chat"]
    },
    "tier": {
      "type": ["string", "null"],
      "enum": ["A", "B", "mixed", null]
    },
    "coaching_focus": {
      "type": "string",
      "enum": [
        "judgement_quality",
        "combo_continuity",
        "recovery_after_miss",
        "density_or_difficulty",
        "consistency",
        "lane_execution",
        "timing_bias",
        "timing_spread",
        "calibration_check",
        "progression",
        "data_quality",
        "none"
      ]
    },
    "speech": { "type": "string" },
    "phone_text": {
      "type": "array",
      "items": { "type": "string" }
    },
    "what_went_well": {
      "type": ["string", "null"]
    },
    "observations": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "string" },
          "interpretation": { "type": "string" }
        },
        "required": ["label", "value", "interpretation"]
      }
    },
    "drill": {
      "type": ["string", "null"]
    },
    "next_target": {
      "type": ["string", "null"]
    },
    "focus_section": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "start_s": { "type": "integer" },
        "end_s": { "type": "integer" },
        "reason": { "type": "string" }
      },
      "required": ["start_s", "end_s", "reason"]
    },
    "data_notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "evidence_basis": {
      "type": "string",
      "enum": [
        "measured_run_data",
        "cross_run_pattern",
        "game_heuristic",
        "practice_convention",
        "mixed_evidence",
        "none"
      ]
    }
  },
  "required": [
    "mode",
    "tier",
    "coaching_focus",
    "speech",
    "phone_text",
    "what_went_well",
    "observations",
    "drill",
    "next_target",
    "focus_section",
    "data_notes",
    "confidence",
    "evidence_basis"
  ]
}
